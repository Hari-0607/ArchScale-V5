{
  "name": "archscale-v05-auth",
  "version": "0.5.0",
  "type": "module",
  "description": "ArchScale V05 Organisation-First Auth and Authorisation Layer",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "walkthrough": "vitest run scripts/phase1_walkthrough.ts",
    "testbench": "node testbench/server.js",
    "proof": "node demo/server.js",
    "server": "node -e \"import('./dist/server/index.js').then(m => m.createServer().listen(3000, '127.0.0.1', () => console.log('Listening on http://127.0.0.1:3000')))\"",
    "dev:server": "tsx -e \"import('./src/server/index.js').then(m => m.createServer().listen(3000, '127.0.0.1', () => console.log('Listening on http://127.0.0.1:3000')))\"",
    "build": "tsc"
  },
  "keywords": [
    "auth",
    "security",
    "multi-tenant",
    "rbac",
    "rls"
  ],
  "author": "ArchScale Platform Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
