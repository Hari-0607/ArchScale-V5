# =============================================================================
# ArchScale V05 Phase 2 Staging Environment Variables
# NEVER COMMIT REAL KEYS TO SOURCE CONTROL
# =============================================================================

# Deployment Environment - Must be explicitly 'staging'
ARCHSCALE_ENV=staging

# Supabase Staging Project Configuration
# SUPABASE_URL must contain project reference or staging indicator
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
# SERVICE_ROLE_KEY used ONLY by seeds/reset_staging_users.ts and admin session revocation
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Staging Database Direct Connection (PostgreSQL port 5432 or 6543)
# Used for applying migrations and admin DB operations
SUPABASE_DB_ADMIN_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Runtime Role Connection (migration 010 creates LOGIN role archscale_app_runtime)
# Used for all normal backend operations (never superuser)
ARCHSCALE_RUNTIME_DB_URL=postgresql://archscale_app_runtime:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Local Development / Test Flags (Strictly disabled when staging credentials are present)
ALLOW_LOCAL_AUTH_PROVIDER=false
