# =============================================================================
# ArchScale V05 Phase 2 Staging Environment Variables Template
# NEVER COMMIT REAL KEYS TO SOURCE CONTROL
# =============================================================================

# Deployment Environment - Must be explicitly 'staging'
ARCHSCALE_ENV=staging

# Supabase Staging Project Configuration
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
# SERVICE_ROLE_KEY used ONLY by seeds/reset_staging_users.ts and admin session revocation
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Staging Database Admin Connection (PostgreSQL pooler port 6543 or direct port 5432)
SUPABASE_DB_ADMIN_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Runtime Role Connection (migration 010 creates LOGIN role archscale_app_runtime)
ARCHSCALE_RUNTIME_DB_URL=postgresql://archscale_app_runtime:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Local Development / Test Flags (Strictly disabled when staging credentials are present)
ALLOW_LOCAL_AUTH_PROVIDER=false
