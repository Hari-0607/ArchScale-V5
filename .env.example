# Local Supabase development (copy to .env; replace keys with `supabase start` output)
ARCHSCALE_ENV=development
ARCHSCALE_FRONTEND_URL=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
# Server/CLI only. Never add this value to VITE_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY
SUPABASE_DB_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
ARCHSCALE_RUNTIME_DB_URL=postgresql://archscale_app_runtime:archscale_runtime_local_pass@127.0.0.1:55322/postgres
ARCHSCALE_LOCAL_DEMO_EMAIL=investigator@example.test
# Local-only starter password. Change it in .env before sharing the machine.
ARCHSCALE_LOCAL_DEMO_PASSWORD=LocalDemo123!
ARCHSCALE_LOCAL_MEMBER_EMAIL=design.lead@example.test
ARCHSCALE_LOCAL_MEMBER_PASSWORD=LocalLead123!
ARCHSCALE_LOCAL_STAFF_EMAIL=designer.member@example.test
ARCHSCALE_LOCAL_STAFF_PASSWORD=LocalMember123!
ARCHSCALE_LOCAL_PARTNER_EMAIL=partner@example.test
ARCHSCALE_LOCAL_PARTNER_PASSWORD=LocalPartner123!

# For tests only, use a disposable local database. The test harness drops and
# recreates isolated databases, and rejects non-loopback hosts.
ARCHSCALE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
ARCHSCALE_LOCAL_RUNTIME_PASSWORD=archscale_runtime_local_pass
ALLOW_LOCAL_AUTH=false

# Staging only: set ARCHSCALE_ENV=staging and configure the project ref and
# matching hosted URLs/keys separately. Never use production credentials for tests.
ARCHSCALE_STAGING_PROJECT_REF=

